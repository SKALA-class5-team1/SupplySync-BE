# 복사해서 .env로 만든 뒤 비밀번호를 바꿔 사용한다. .env는 커밋하지 않는다.
# docker compose와 Spring Boot(application.yml)가 같은 파일을 읽는다.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supplysync
# 앱이 접속하는 계정 (Flyway 마이그레이션 포함)
DB_USER=supplysync_app
DB_PASSWORD=changeme
# Supabase: sslmode=require, schema=public,extensions (vector 확장을 extensions에 설치한 경우)
DB_SSLMODE=disable
DB_SCHEMA=public
# 앱 1개가 잡는 DB 연결 수 (Supabase 무료 풀러는 한도가 작다). 여러 명이 같은 DB를 쓰면 줄인다
DB_POOL_MAX=3
DB_POOL_MIN_IDLE=1
# pg_stat_activity에서 누가 연결했는지 구분하는 이름. 팀원마다 다르게 정한다 (예: supplysync-be-kim)
DB_APPLICATION_NAME=supplysync-be
# 컨테이너 관리자 계정. 앱에서는 쓰지 않는다
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=changeme-admin
# RAG 검색용 읽기 전용 계정 예시. 새 문서 적재가 필요하면 Agent 팀과 별도 쓰기 권한·계정을 확정한다.
# 비워 두면 만들지 않는다. 이름은 rag_reader로 두는 것을 권장한다.
RAG_DB_USER=rag_reader
RAG_DB_PASSWORD=changeme-rag

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=supplysync
RABBITMQ_PASSWORD=changeme

# --- 내부 API (/internal/**) 호출 키: MCP 서버와 Agent가 X-Internal-Api-Key 헤더로 보낸다 ---
INTERNAL_API_KEY=changeme-internal-key

# --- 멈춘 작업 감시 (기본값 그대로 쓰면 된다) ---
WATCHDOG_ENABLED=true
WATCHDOG_QUEUED_MINUTES=10
WATCHDOG_ACTIVE_MINUTES=30

# --- 앱 ---
SERVER_PORT=8080
# 업로드된 RFQ 원문 파일 저장 디렉터리 (rfqs.file_path는 이 디렉터리 기준 상대 경로)
RFQ_FILES_DIR=./rfq-files
# Agent 서버 계약 확정 후 지정 (예: http://agent:8000)
AGENT_BASE_URL=
# RabbitMQ 분석 요청·재개 경로 (기본 true). 개발 중 Agent HTTP를 직접 호출하려면 false
ANALYSIS_MQ_ENABLED=true
# Agent가 analysis.request.q를 직접 소비하면 false로 둔다 (Spring은 발행만 한다). 기본 true는 Spring이 소비해 Agent HTTP를 호출한다
ANALYSIS_MQ_CONSUMER_ENABLED=true
# Agent 호출 실패 시 재시도 횟수 (0이면 한 번만 호출하고 실패하면 작업을 FAILED로 처리)
ANALYSIS_REQUEST_RETRIES=0
# Agent 응답 대기 시간(초). 초과하면 호출 실패로 처리
AGENT_READ_TIMEOUT_SECONDS=300
# 32바이트 이상 난수를 Base64로 인코딩한 값. 예: openssl rand -base64 32
JWT_SECRET_BASE64=replace-with-random-base64-secret
JWT_ISSUER=supplysync
JWT_ACCESS_TOKEN_SECONDS=3600
# 프론트가 다른 origin에서 실행된다면 쉼표로 구분 (예: http://localhost:5173)
FRONTEND_ORIGINS=
