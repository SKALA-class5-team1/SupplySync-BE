# 복사해서 .env로 만든 뒤 비밀번호를 바꿔 사용한다. .env는 커밋하지 않는다.
# docker compose와 Spring Boot(application.yml)가 같은 파일을 읽는다.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supplysync
# 앱이 접속하는 계정 (Flyway 마이그레이션 포함)
DB_USER=supplysync_app
DB_PASSWORD=changeme
# 컨테이너 관리자 계정. 앱에서는 쓰지 않는다
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=changeme-admin
# rag MCP 전용 읽기 전용 계정. doc_chunks만 조회할 수 있다 (Flyway V1이 권한을 부여).
# 비워 두면 만들지 않는다. 이름은 rag_reader로 두는 것을 권장한다
RAG_DB_USER=rag_reader
RAG_DB_PASSWORD=changeme-rag

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=supplysync
RABBITMQ_PASSWORD=changeme

# --- 내부 API (/internal/**) 호출 키: MCP 서버와 Agent가 X-Internal-Api-Key 헤더로 보낸다 ---
INTERNAL_API_KEY=changeme-internal-key

# --- 앱 ---
SERVER_PORT=8080
