flowchart TB
    P1["생산자<br/>RFQ 등록 · 확인 · 승인 API"] -->|"analysis.requested<br/>analysis.resume"| X
    P2["생산자<br/>저장 · 등록 처리"] -->|"analysis.completed<br/>analysis.failed"| X
    P3["생산자<br/>임베딩 요청"] -->|"document.embed.requested"| X

    X{{"supplysync.analysis<br/>topic exchange"}}

    X -->|"requested · resume"| Q1[["analysis.request.q"]]
    X -->|"completed · failed"| Q2[["analysis.result.q"]]
    X -->|"embed.requested"| Q3[["document.embed.q"]]

    Q1 --> C1["소비자<br/>중복 확인 → 상태 전이 → Agent 호출<br/>(재시도 3회)"]
    Q2 --> C2["소비자<br/>상태 갱신 · SSE 중계"]
    Q3 --> C3["소비자<br/>EmbeddingService"]

    Q1 -.->|"reject (재시도 소진)"| D
    Q2 -.->|reject| D
    Q3 -.->|reject| D

    D{{"supplysync.analysis.dlx<br/>direct exchange"}}

    D --> DQ1[["analysis.request.dlq"]]
    D --> DQ2[["analysis.result.dlq"]]
    D --> DQ3[["document.embed.dlq"]]

    DQ1 --> DC["DLQ 소비자<br/>ai_tasks → FAILED · SSE FAILED"]
    DQ1 --> OP["운영자<br/>원인 조사 → 재처리 / 폐기"]
    DQ2 --> OP
    DQ3 --> OP
